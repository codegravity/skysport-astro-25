---
import Layout from "@layouts/MainLayout.astro";
import { kursPriser26 } from '@data/prisData';
import VideoHero from "@components/sections/VideoHero.astro";
import Feature50 from  "@sections/Feature-50-50.astro";
import ListWidget from "@widgets/listwidget.astro";
import KursInfo from  "@sections/Feature-50-50.astro";
import SivImage from '@assets/images/kurs/siv-inslagg.jpg';
import featureImg3 from "@assets/images/kurs/1a.jpg";
import SivForm from "@components/elements/forms/SIVForm.astro";
import Divider1 from  "@elements/SeparatorLine.astro";
import { Breadcrumbs } from "astro-breadcrumbs";
import "astro-breadcrumbs/breadcrumbs.css";

const customLastPart = [
  { index: "last", text: "SIV (säkerhetskurs)" },
  {
    "data-link": "Kurs",
    "aria-label": "Go to the home page",
    text: "Kurs",
  },
  {
    "data-link": "Fort",
    "aria-label": "Go to the about page",
    text: "Fortsättningskurser",
  },
];

import sivPoster from '@assets/images/video-posters/siv-poster.jpg';

//S3
/*
const myVideo ="https://strapi-cdn-2.s3.eu-north-1.amazonaws.com/skysport25/video/SIV/SIV2.mp4";
const mobVideo = "https://strapi-cdn-2.s3.eu-north-1.amazonaws.com/skysport25/video/SIV/siv-mobile.mp4";
const tabVideo = "https://strapi-cdn-2.s3.eu-north-1.amazonaws.com/skysport25/video/SIV/SIV2.mp4";
*/
// super cloud
const myVideo ="https://cdn26.skysport.se/siv/SIV2.mp4";
const mobVideo = "https://cdn26.skysport.se/siv/siv-mobile.mp4";
const tabVideo = "https://cdn26.skysport.se/siv/SIV2.mp4";

const VideoContent = {
    backgroundVideo: myVideo,
     mobileVideo: mobVideo,
    tabVideo: tabVideo,
    videoPoster: sivPoster,
    overlayOpacity: 0.2,
    page: "tandem",
   // position: "justify-end",
    playIconColour: "white",
 pauseIconColour: "white",
}

/* const HeroContent = {
    title: "Tandemflyg hos Skysport",
    description: "A good place to start.",
    backgroundImage: HeroImage,
    overlayOpacity: 0.2
} */

const svenskKursPris =   kursPriser26[1].kursPrisSvensk;
const svenskKursPrisISO = new Intl.NumberFormat('sv-SE', { style: 'currency', currency: 'SEK'}).format(svenskKursPris); 
const norskkurspris =   kursPriser26[1].kursPrisNorsk;
const norskkursPrisISO = new Intl.NumberFormat('sv-SE', { style: 'currency', currency: 'SEK'}).format(norskkurspris);

const Feature50Content = {
     infoTitle: 'Säkerhetskurs i Åre',
     infoText: [
      {
        preText: ' ',
        spanText: 'Vill du ta din flygning till nästa nivå och känna dig tryggare under din skärm?',
        spanClasses: 'text-xl font-bold text-gray-600',
        postText: '',
      },
      {
        preText: 'Bemästra din skärm – Bli en säkrare och tryggare pilot genom att gå vår SIV-kurs i Åre! Under juni till september bjuder vi in dig till Åre för sommarens mest givande kurs.',
        spanText: '',
        spanClasses: 'text-xl font-bold text-orange-600',
        postText: 'Vi utför fullt SIV program enligt svenska eller norska krav.',
      },
      {
        preText: 'SIV eller säkerhetskursen tycker vi på Skysport är ett måste för alla piloter som vill utveckla sin flygning, inte minst om du vill flyga i berg och i termiska förhållanden. ',
        spanText: '',
        spanClasses: 'text-xl font-bold text-orange-600',
        postText: '',
      },
      {
        preText: 'Med säkerhetskursen når du som pilot en ny nivå av självförtroende, skärmkontroll och du kommer vara en båda bättre och säkrare pilot. Vi anpassar kursen efter dina mål och du måste inte nödvändigtvis utföra hela programmet, om du inte vill. Du kanske har ett särskilt fokus på vissa manövrar och vill finslipa specifika delar. (För godkännande av SIV kurs måste alla manövrar utföras)',
        spanText: '',
        spanClasses: 'text-xl font-bold text-orange-600',
        postText: '',
      },
     ],
    infoImg:  SivImage,
    infoIcon: '',
}

const  SIVkursListContent = {
  listTitle: "Varför välja vår säkerhetskurs?",
  listDescription: '',
  listIcon: '',
  listList: [
    {
      listItem: 'Personliga och noggranna genomgångar inför varje enskilt moment, båda i våra simulatorer i Skysports teorisal och på video. Vi bryter ner teorin så att du känner dig väll förberedd infor varje flyg.',
    },
    {
      listItem: 'Maximal trygghet: Alla manövrar sker över Åresjön med bemannad upphämtningsbåt, flytväst och konstant radiokontakt. Din säkerhet är vår högsta prioritet.'
    },
    {
      listItem: 'Analys som ger resultat: Efter varje flyg går vi igenom din prestation moment för moment. Med videoanalys och expertfeedback ser vi till att kunskapen verkligen fastnar.'
    },
    {
      listItem: 'Effektivt upplägg: Säkerhetskursen pågår vanligen 2–3 flygdagar (ca 5–7 flyg) Under den relativt korta tiden genomgår du en total förvandling som pilot.'
    },
  ],
}
const Feature50ContentSIV = {
     infoTitle: '',
     infoOrientationL: false,
     infoColL: 'sm:order-1',
     infoColR: 'sm:order-2',
     infoAnchorLink: 'berg4',
     infoDescription: '',
     isTandemPage: false,
     isKursPage: true,
     infoText: [
        {
        preText: '',
        spanText: 'Vad krävs av dig?',
        spanClasses: 'text-2xl text-slate-800 dark:text-slate-200 ',
        postText: '',
      },
              {
        preText: 'Du har en giltig elevlicens eller högre.',
        spanText: '',
        spanClasses: 'text-slate-800 dark:text-slate-200 italic',
        postText: '',
      },
                  {
        preText: 'Du har radio och flytväst, (radio går att hyra via Skysport).',
        spanText: '',
        spanClasses: 'text-slate-800 dark:text-slate-200 italic',
        postText: '',
      },      {
        preText: '',
        spanText: 'Boende finns att hyra vid Draklanda/Lake Lodge.',
        spanClasses: 'text-slate-800 dark:text-slate-200 ',
        postText: ' ',
      }, 
             {
        preText: ' ',
        spanText: 'Svensk SIV ' + svenskKursPrisISO ,
        spanClasses: ' font-bold',
        postText: '',
      }, 
            {
        preText: ' ',
        spanText:  ' Norsk SIV ' + norskkursPrisISO + ' *',
        spanClasses: ' font-bold',
        postText: '',
      },
      {
        preText: '',
        spanText: '*Priser i SEK',
        spanClasses: 'text-sm text-slate-800 dark:text-slate-200 italic',
        postText: ' ',
      },
    ],
    infoImg:  featureImg3,
    imgHeight: 1200,
    imgWidth: 685,
    infoIcon: '',
 /*    buttons: [
      {
        text: "Boka Grundkurs",
        link: "/Kurs/Grundkurs/boka",
        target: "_self",
      },
    ], */
}

---

<Layout title="Skysport Tandemflyg i Åre" description="" keywords="" >
<!--    <Topper /> -->
    <VideoHero content={VideoContent}/>  
    <div class=" py-8 px-4 sm:px-8  md:px-68   dark:text-slate-200">
      <Breadcrumbs linkTextFormat="capitalized" separatorAriaHidden={false} customizeLinks={customLastPart}>
          <svg
              slot="index"
              aria-label="Home Page"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"> </path><polyline
              points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <svg
              slot="separator"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polyline points="9 18 15 12 9 6"></polyline>
          </svg>
      </Breadcrumbs>
  </div> 
  <Divider1 />
  <Feature50 content={Feature50Content} />
  <ListWidget content={SIVkursListContent} />
    <KursInfo content={Feature50ContentSIV}/>
  <SivForm />
</Layout>
